# Leave blank until the official HTTPS origin has been approved.
SITE_ORIGIN=
# Release defaults to noindex. Set true after approval and domain confirmation.
ENABLE_INDEXING=false
# Build-time public contact details, approved before use.
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_PHONE_LABEL=
# Same-origin root path reserved for the future PHP application.
API_BASE_PATH=/api/
